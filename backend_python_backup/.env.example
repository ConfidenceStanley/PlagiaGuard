# Application
APP_NAME=PlagiaGuard
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your_super_secret_jwt_key_change_this

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/plagiarism_db

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Search API
BING_SEARCH_API_KEY=your_bing_key
GOOGLE_API_KEY=your_google_key
GOOGLE_SEARCH_ENGINE_ID=your_engine_id

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://plagiarguard.vercel.app